# ─── Frontend Borne (src/frontend/) ──────────────────────────────────────────
# URL du backend API
VITE_API_URL="http://localhost:3000"
# Production : VITE_API_URL="https://estimer-mes-aides-production.up.railway.app"

# API Key mobile V1 (rétrocompatibilité)
VITE_API_KEY="ema_mobile_xxxxxxxxxxxxxxxxxxxx"

# ID de la borne (optionnel — peut aussi être configuré dynamiquement)
# VITE_BORNE_ID="uuid-de-la-borne"

# ─── Pusher (pilotage à distance de la borne) ────────────────────────────────
# REQUIS en production : sans VITE_PUSHER_KEY au moment du BUILD, connectBorneChannel()
# (src/services/borneRemoteControl.js) retombe en no-op et le forçage login/logout
# depuis le back-office ne fonctionne plus. Valeur = clé publique Pusher (app key),
# identique à PUSHER_KEY côté backend. Ne jamais mettre PUSHER_SECRET ici.
VITE_PUSHER_KEY="your_pusher_key"
# Cluster Pusher — défaut 'eu' si absent (optionnel mais à aligner avec le backend)
VITE_PUSHER_CLUSTER="eu"
