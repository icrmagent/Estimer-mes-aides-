# ─── Base de données PostgreSQL (Supabase) ────────────────────────────────────
# connection_limit=10 configures the Prisma connection pool (task 27.5)
# Adjust based on your Supabase plan (free tier: max 15 connections)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.zxkshqviyzjigadruody.supabase.co:5432/postgres?connection_limit=10&pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.zxkshqviyzjigadruody.supabase.co:5432/postgres"

# ─── Auth & API Keys ──────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
JWT_SECRET="votre-jwt-secret-minimum-32-caracteres"
API_KEY_MOBILE="ema_mobile_xxxxxxxxxxxxxxxxxxxx"
API_KEY_CRM="ema_crm_xxxxxxxxxxxxxxxxxxxx"

# ─── Pusher WebSocket (V2) ────────────────────────────────────────────────────
# Créer un compte sur https://pusher.com et créer une app Channels
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="eu"

# ─── Médias de l'écran de veille — Supabase Storage (OPTIONNEL) ───────────────
# Sans ces valeurs, l'envoi de fichiers répond 503 et le back-office n'accepte que
# des URLs. Le bucket public est créé au premier envoi (src/services/storageService.js).
# SERVICE_ROLE contourne les RLS : variable serveur uniquement, jamais de VITE_ devant.
# SUPABASE_URL est facultative : déduite sinon de DATABASE_URL (utilisateur postgres.<ref>).
# La clé accepte le format service_role (JWT) ou sb_secret_… ; alias : SUPABASE_KEY.
SUPABASE_URL="https://<projet>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ecrans-veille"

# ─── SuperAdmin initial (V2) ──────────────────────────────────────────────────
# Utilisé par le script de seed pour créer le premier SuperAdmin
SUPERADMIN_EMAIL="admin@estimer-mes-aides.fr"
SUPERADMIN_PASSWORD_TEMP="ChangeMe2026!"

# ─── CRM externe (V2 — partage asynchrone) ───────────────────────────────────
CRM_API_URL="https://app-web-abondance-dev-webapi.azurewebsites.net"
CRM_API_KEY="<JWT Bearer token I-CRM — à renouveler à l'expiration>"
CRM_USER_ID="1"

# ─── Redis (required in production — ADR-3 fail-secure caching) ──────────────
# Used for JWT blacklist, brute force protection, and response caching
REDIS_URL="redis://localhost:6379"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# REQUIS. Liste d'origines séparées par des virgules — src/app.js fait
# split(',') + trim() puis compare l'origine à l'identique (protocole + host + port,
# SANS slash final). Prod : borne + back-office. Dev : ajouter les origines localhost.
CORS_ALLOWED_ORIGINS="https://estimer-mes-aides.vercel.app,https://estimer-mes-aides-wjp3.vercel.app"
# Dev : CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5175"

# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Observabilité (toutes OPTIONNELLES) ─────────────────────────────────────
# Sentry — si absent, le suivi d'erreurs est simplement désactivé (src/lib/sentry.js)
SENTRY_DSN=""
# Couleur primaire V2 imposée aux formulaires — défaut #5B2D8E si absent (src/config/brand.js)
PRIMARY_COLOR="#5B2D8E"
# Datadog APM — le tracer ne démarre que si DD_API_KEY ou DD_AGENT_HOST est défini (src/lib/tracer.js)
DD_API_KEY=""
DD_AGENT_HOST=""
# New Relic — alternative à Datadog, utilisée seulement si aucune var DD_* n'est définie
NEW_RELIC_LICENSE_KEY=""
# StatsD / DogStatsD — défauts localhost:8125 si absents (src/lib/metrics.js)
STATSD_HOST="localhost"
STATSD_PORT="8125"

# ─── Scripts de maintenance (OPTIONNEL) ──────────────────────────────────────
# Token I-CRM consommé uniquement par scripts/update-canal-token.js (non lu par le serveur)
ICRM_TOKEN=""
