# --- Back-Office (src/backoffice/) -------------------------------------------
# URL du backend API. REQUIS : sans elle les appels partent sur une URL vide.
VITE_API_URL=http://localhost:3000
# Production : VITE_API_URL=https://estimer-mes-aides-production.up.railway.app

# --- Pusher (notifications temps reel + pilotage des bornes) ------------------
# REQUIS en production. Inlinee par Vite au BUILD : si elle est absente,
# src/services/pusherService.js se rabat sur la cle factice "placeholder",
# la connexion Pusher echoue et le back-office ne recoit plus les nouveaux
# enregistrements en direct ni les accuses de force-login/force-logout.
# Valeur = cle publique Pusher (app key), identique a PUSHER_KEY cote backend.
# Ne jamais mettre PUSHER_SECRET ici : le bundle est public.
VITE_PUSHER_KEY=your_pusher_key
# Cluster Pusher (optionnel, defaut "eu" dans le code) - doit correspondre a PUSHER_CLUSTER.
VITE_PUSHER_CLUSTER=eu
